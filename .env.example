# PostgreSQL/Supabase. No Render, prefira o Transaction Pooler na porta 6543.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Mesmo serviço e token usados pelo NSAgent para acessar o TRAYadaptor.
TRAY_ADAPTOR_URL=https://trayadaptor.onrender.com
TRAY_ADAPTOR_TOKEN=

BI_API_KEY=troque-por-uma-chave-forte
JWT_SECRET=troque-por-um-segredo-forte
AUTH_ADMIN_USERNAME=admin@newstore.com.br
AUTH_ADMIN_PASSWORD=
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
CORS_ORIGINS=http://localhost:5173,https://ns-bi-frontend.vercel.app
SYNC_ORDERS_MINUTES=10
SYNC_CATALOG_HOURS=6
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
REDIS_URL=
